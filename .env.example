# Copy to .env and adjust. .env is git-ignored.

# SSH target of the Home Assistant instance (user@host)
HA_HOST=root@homeassistant.local

# SSH port (optional, default 22)
#HA_SSH_PORT=22

# Home Assistant config directory on the instance (optional, default /config)
#HA_CONFIG=/config

# Full target directory for the custom components (optional,
# default ${HA_CONFIG}/custom_components)
#HA_TARGET=/config/custom_components
